# Atlas environment overrides.
# Runtime settings are normally read from ~/.atlas/config/settings.toml.
# These variables are optional and intended for development/CI.

ATLAS_ENV=development
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
ATLAS_DATA_DIR=
ATLAS_LOG_LEVEL=info
ATLAS_MODEL_PROVIDER=openai
ATLAS_CHAT_MODEL=gpt-4o
ATLAS_EMBEDDING_MODEL=text-embedding-3-small

# --- AI Provider API Keys ---
# Set the key for whichever provider you choose.

# Google Gemini (required if ATLAS_MODEL_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (required if ATLAS_MODEL_PROVIDER=openai)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (required if ATLAS_MODEL_PROVIDER=anthropic)
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq (required if ATLAS_MODEL_PROVIDER=groq)
# Get a free/paid key at https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek (required if ATLAS_MODEL_PROVIDER=deepseek)
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Mistral AI (required if ATLAS_MODEL_PROVIDER=mistral)
# Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenRouter (required if ATLAS_MODEL_PROVIDER=openrouter)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Together AI (required if ATLAS_MODEL_PROVIDER=together)
# Get a key at https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Ollama (no key needed, just ensure Ollama is running locally)
# OLLAMA_BASE_URL=http://localhost:11434
