# Normalize line endings so the repo is usable on every platform.
#
# Without this, shell scripts authored on Windows are committed with CRLF and
# fail on Linux/macOS with "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

# Shell scripts must be LF everywhere, including when checked out on Windows.
*.sh text eol=lf

# Windows scripts must be CRLF, including when checked out on Linux.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.db binary
*.enc binary
